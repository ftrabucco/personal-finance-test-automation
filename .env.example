# local | staging | prod
TEST_ENV=local

# Frontend URL
E2E_BASE_URL=http://localhost:3001
# For TEST_ENV=staging, point this to the test frontend when it exists.
# E2E_BASE_URL=https://personal-finance-frontend-staging.vercel.app
E2E_PROD_BASE_URL=https://personal-finance-frontend-pied.vercel.app

# API URL
E2E_API_URL=http://localhost:3030/api
# For TEST_ENV=staging:
# E2E_API_URL=https://api-test.178-156-224-127.sslip.io/api
E2E_PROD_API_URL=https://unfortunately-tide-feb-manor.trycloudflare.com/api

# Default dedicated test user.
E2E_USER_EMAIL=e2e@example.com
E2E_USER_PASSWORD=change-me

# Optional environment-specific users. These override E2E_USER_* for each TEST_ENV.
# Use a safe read-only user for production smoke.
# E2E_STAGING_USER_EMAIL=e2e.staging@example.com
# E2E_STAGING_USER_PASSWORD=change-me
# E2E_PROD_USER_EMAIL=e2e.prod@example.com
# E2E_PROD_USER_PASSWORD=change-me

# Safety guard. Destructive tests should require this to be true.
ALLOW_DESTRUCTIVE_TESTS=false
